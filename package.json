{
    "name": "mimi-base",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "build": "vite build && bun check",
        "db": "bun pocketbase/server.ts",
        "dev": "vite --host",
        "dev:all": "bun scripts/dev.ts",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "lint": "eslint .",
        "serve": "vite preview --port=3001",
        "setup:hooks": "git config core.hooksPath .githooks",
        "start": "vite",
        "test": "bun test app lib",
        "typecheck": "bun check",
        "typecheck:tsc": "tsc --noEmit"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@hookform/resolvers": "^7.0.1",
        "@radix-ui/react-avatar": "^1.1.1",
        "@radix-ui/react-context-menu": "^2.2.2",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-dropdown-menu": "^2.1.2",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-popover": "^1.1.2",
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.1",
        "@react-three/drei": "^9",
        "@react-three/fiber": "^8",
        "@tanstack/react-query": "^5.59.14",
        "@tanstack/react-router": "^1.76.1",
        "ahooks": "^3.8.1",
        "antd-mobile-icons": "^0.3.0",
        "bcryptjs": "^1",
        "chart.js": "^4.4.4",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "compressorjs": "^1.2.1",
        "date-fns": "^2.30.0",
        "lucide-react": "^0.453.0",
        "pocketbase": "^0.28.1",
        "react": "^18.3.1",
        "react-chartjs-2": "^5.2.0",
        "react-day-picker": "^8.7.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.53.0",
        "react-intersection-observer": "^9.13.1",
        "sonner": "^1.5.0",
        "tailwind-merge": "^2.5.4",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.187.0",
        "vaul": "^1.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@tanstack/router-plugin": "^1.73.1",
        "@types/bun": "^1.4.4",
        "@types/node": "^22.7.5",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-react": "^6",
        "autoprefixer": "^10.4.20",
        "eslint": "^9",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "postcss": "^8.4.47",
        "rollup-plugin-visualizer": "^7",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.11.0",
        "vite": "^8"
    }
}
