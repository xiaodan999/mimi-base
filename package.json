{
    "name": "mimi-base",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "build": "vite build && bun scripts/check-bundle.ts && bun check",
        "dev:all": "bun scripts/dev.ts",
        "dev:backend": "bun scripts/backends.ts",
        "dev:frontend": "vite --host",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "install:server": "cd server && bun install --frozen-lockfile",
        "lint": "biome lint .",
        "perf": "bun scripts/perf.mjs",
        "preview": "bun scripts/preview.mjs",
        "setup:hooks": "git config core.hooksPath .githooks",
        "test": "bun test --timeout=20000 --path-ignore-patterns=\"tmp/**\"",
        "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=tmp/coverage --timeout=20000 --path-ignore-patterns=\"tmp/**\" && bun scripts/check-coverage.ts",
        "test:pb": "bun scripts/pb-hooks-test.ts",
        "typecheck": "bun check && cd server && bun check"
    },
    "dependencies": {
        "@assistant-ui/react": "0.15.32",
        "@assistant-ui/react-markdown": "0.14.24",
        "@hookform/resolvers": "^7.0.1",
        "@radix-ui/react-context-menu": "^2.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@react-three/drei": "^9",
        "@react-three/fiber": "^8",
        "@tanstack/react-query": "^5.59.14",
        "@tanstack/react-router": "^1.76.1",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "compressorjs": "^1.2.1",
        "date-fns": "^4.4.0",
        "lucide-react": "0.577.0",
        "pdfjs-dist": "5.7.284",
        "pocketbase": "^0.28.1",
        "react": "^18.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.53.0",
        "react-intersection-observer": "^9.13.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.6.0",
        "sonner": "^2",
        "tailwind-merge": "^3",
        "three": "^0.187.0",
        "vaul": "^1.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/router-plugin": "^1.73.1",
        "@types/bun": "^1.4.4",
        "@types/node": "^24",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-react": "^6",
        "playwright-core": "^1.65.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "vite": "^8"
    },
    "overrides": {
        "@napi-rs/canvas": "npm:empty-npm-package@1.0.0"
    }
}
