{
    "name": "mimi-base",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "build": "vite build && bun check",
        "db": "bun scripts/backends.ts",
        "dev": "vite --host",
        "dev:all": "bun scripts/dev.ts",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "install:server": "cd server && bun install --frozen-lockfile",
        "lint": "biome lint .",
        "perf": "bun scripts/perf.mjs",
        "preview": "bun scripts/preview.mjs",
        "serve": "vite preview --port=3001",
        "setup:hooks": "git config core.hooksPath .githooks",
        "start": "vite",
        "test": "bun test --path-ignore-patterns=\"tmp/**\"",
        "typecheck": "bun check && cd server && bun check"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@assistant-ui/react": "0.15.32",
        "@assistant-ui/react-markdown": "0.14.24",
        "@hookform/resolvers": "^7.0.1",
        "@radix-ui/react-avatar": "^1.1.1",
        "@radix-ui/react-context-menu": "^2.2.2",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-dropdown-menu": "^2.1.2",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-popover": "^1.1.2",
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.1",
        "@react-three/drei": "^9",
        "@react-three/fiber": "^8",
        "@tanstack/react-query": "^5.59.14",
        "@tanstack/react-router": "^1.76.1",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "compressorjs": "^1.2.1",
        "date-fns": "^3",
        "lucide-react": "^0.453.0",
        "pocketbase": "^0.28.1",
        "react": "^18.3.1",
        "react-day-picker": "^8.7.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.53.0",
        "react-intersection-observer": "^9.13.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.6.0",
        "sonner": "^1.5.0",
        "tailwind-merge": "^3",
        "three": "^0.187.0",
        "vaul": "^1.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/router-plugin": "^1.73.1",
        "@types/bun": "^1.4.4",
        "@types/node": "^22.7.5",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-react": "^6",
        "playwright-core": "^1.65.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "vite": "^8"
    }
}
