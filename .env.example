VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Vite 端口，默认 3000。另一个 worktree 占用 3000 时改这里（或启动时加
# VITE_PORT=3001）。
# VITE_PORT=3001

# PocketBase 端口，默认 8090。每个 worktree 用不同端口即可各用各的
# pocketbase/pb_data（或启动时加 PB_PORT=8091）。
# PB_PORT=8091

# 站点 AI（OpenCode Go）。开发时放这里；生产放 .env.prod。Key 只在 Bun
# supervisor 里使用，不会下发到浏览器。留空则 AI 功能返回 503。
# OPENCODE_API_KEY=sk-...
# OPENCODE_MODEL=deepseek-v4.1-flash
# 每个登录用户每天最多请求多少次（0 = 不限制）。
# AI_DAILY_REQUESTS_PER_USER=100

# 通用聊天（/chat）可选的模型白名单，逗号分隔。模型 id 由服务端决定，
# 客户端只能从 GET /ai/models 返回的列表里选；传其它 id 会被中转拒绝。
# 留空则使用 pocketbase/chat-models.ts 里的三个模型：
# deepseek-v4.1-flash、glm-5.3-flash、mimo-v2.6-flash。
# OPENCODE_CHAT_MODELS=deepseek-v4.1-flash,glm-5.3-flash,mimo-v2.6-flash
# 新对话默认模型；留空时优先用 OPENCODE_MODEL（若它在白名单里），否则用第一个。
# OPENCODE_CHAT_MODEL_DEFAULT=deepseek-v4.1-flash
# 思考强度（reasoning_effort: low/high/max）由客户端按模型能力提供，
# 服务端会按白名单里的 thinkingLevels 校验；MiMo 2.6 Flash 不支持调整。

# 服务器沙箱的基础镜像。默认 python:3.12-slim；国内服务器可换成
# 可用的镜像源，例如：
# SANDBOX_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# JavaScript 沙箱镜像，默认 node:22-alpine。
# SANDBOX_BASE_IMAGE_NODE=docker.m.daocloud.io/library/node:22-alpine

# AI 中转和部署端点共用的 Bun 端口，默认 9001。dev:all 会自动挑一个空闲
# 端口；生产不要设置（反向代理固定转发到 9001）。
# SUPERVISOR_PORT=9001

# 问题反馈 -> GitHub Issue。GITHUB_TOKEN 只在 Bun supervisor 里使用，不会
# 下发到浏览器或 PocketBase；建议用只有目标仓库 issues:write 权限的 fine-grained
# token。留空（或 GITHUB_REPO 为空）时反馈仍会保存在 PocketBase，status 保持
# stored，界面提示「已收到反馈，暂未同步 GitHub」，不会丢数据。
# GITHUB_TOKEN=github_pat_xxx
# 目标仓库，格式 owner/repo。
# GITHUB_REPO=owner/repo
# GitHub API 地址，默认 https://api.github.com；只有测试或 GitHub Enterprise
# 兼容 API 才需要改。生产反代要把 /feedback/report 转发到 supervisor（9001），
# 但不要占用前端路由 /feedback。
# GITHUB_API_URL=https://api.github.com

# 部署到 Vercel 时，必须在 Vercel 项目的环境变量里把
# VITE_POCKETBASE_URL 设为绝对地址（不能用 same-origin / 127.0.0.1），例如：
# VITE_POCKETBASE_URL=https://pb.example.com
# 否则 lib/env.ts 在加载时会直接抛错。Vercel 是独立的前端域名，和自托管
# PocketBase 页面是两个 origin，各自的 SW 缓存与 localStorage 互不相通
# （mimi:ai:v1、mimi-theme、AI 缓存需要分别设置一次）。详见 README 第十一节。
