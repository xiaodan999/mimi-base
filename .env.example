# 开发用 same-origin：Vite 把 /db 代理到 PocketBase，把 /api 代理到 Bun
# API。部署时填 PocketBase 的 origin（例如 https://pb.example.com），
# lib/env.ts 会自动挂到 /db 下；写成 https://pb.example.com/db 也可以。
VITE_POCKETBASE_URL=same-origin

# Vite 端口，默认 3000。另一个 worktree 占用 3000 时改这里（或启动时加
# VITE_PORT=3001）。
# VITE_PORT=3001

# PocketBase 端口，默认 8090。每个 worktree 用不同端口即可各用各的
# pocketbase/pb_data（或启动时加 PB_PORT=8091）。
# PB_PORT=8091

# 站点 AI（OpenAI 兼容）。开发时放这里；生产放 .env.app。Key 只在 Bun
# API 里使用，不会下发到浏览器。留空则 AI 功能返回 503。
# AI_API_KEY=sk-...
# 可选：上游基础地址（中转会自己拼 /chat/completions）。默认 OpenCode Go
# （https://opencode.ai/zen/go/v1）。本地不花钱调试：
#   bunx emulate --service ai
# 然后把这里指到 http://127.0.0.1:4000/v1，Key 填 test 即可。
# AI_API_URL=http://127.0.0.1:4000/v1
# AI_MODEL=deepseek-v4.1-flash
# 每个登录用户每天最多请求多少次（0 = 不限制）。
# AI_DAILY_REQUESTS_PER_USER=100

# 通用聊天（/chat）可选的模型白名单，逗号分隔。模型 id 由服务端决定，
# 客户端只能从 GET /api/ai/models 返回的列表里选；传其它 id 会被中转拒绝。
# 留空则使用 server/chat-models.ts 里的三个模型：
# deepseek-v4.1-flash、glm-5.3-flash、mimo-v2.6-flash。
# AI_CHAT_MODELS=deepseek-v4.1-flash,glm-5.3-flash,mimo-v2.6-flash
# 新对话默认模型；留空时优先用 AI_MODEL（若它在白名单里），否则用第一个。
# AI_CHAT_MODEL_DEFAULT=deepseek-v4.1-flash
# 思考强度（reasoning_effort: low/high/max）由客户端按模型能力提供，
# 服务端会按白名单里的 thinkingLevels 校验；MiMo 2.6 Flash 不支持调整。

# 容器部署的运行配置不在这个文件里：见 docker/.env.app.example
# （PB_URL、AI_*、GITHUB_*、SUPERUSER_*）。

# 本地后端端口。API_PORT 只是 dev:all / dev:backend 的起始端口：
# scripts/backends.ts 找一个空闲端口后，以 PORT 传给 Bun API；被占用时会
# 自动往后挑，所以这里写的值不保证最终端口。生产不要设置 API_PORT
# （反向代理固定转发到 9001）。
# API_PORT=9001

# Bun API 自己的监听端口（server/config.ts，默认 9001）。一般不用改：
# dev 脚本会按上面的 API_PORT 覆盖它，容器镜像固定 9001。
# PORT=9001

# Bun API 的绑定地址，默认 0.0.0.0；dev 脚本在未设置时改用 127.0.0.1。
# HOST=0.0.0.0

# 构建后的 SPA 目录，默认仓库根下的 build/；容器里是 /app/build。
# STATIC_DIR=build

# 开发模式开关。设成 1 时启用 dev 种子账号、IP 城市兜底，并把同一个变量
# 传给 PocketBase 的 dev_seed 钩子；dev:all / dev:backend 会自动设成 1。
# 生产不要设置。
# MIMI_DEV=1

# 问题反馈 / 功能建议 -> GitHub Issue。GITHUB_TOKEN 只在 Bun API 里使用，
# 不会下发到浏览器或 PocketBase；建议用只有目标仓库 issues:write 与
# contents:write 权限的 fine-grained token（附件要写 Release）。
# 留空（或 GITHUB_REPO 为空）时文字反馈仍会保存在 PocketBase，status 保持
# stored，界面提示「已收到反馈，暂未同步 GitHub」；带附件的提交会提示先把
# 附件移除，不会丢数据。
# 问题反馈创建 [Bug] + bug/from-app 的 issue；功能建议创建
# [Feature] + enhancement/from-app 的 issue。附件（图片或任意文件，最多 3 个、
# 每个 10MB）先上传到 `feedback-assets` prerelease，再把公开链接写进 issue；
# 仓库是公开的，所以附件也公开可见。
# GITHUB_TOKEN=github_pat_xxx
# 目标仓库，格式 owner/repo。
# GITHUB_REPO=owner/repo
# GitHub API 地址，默认 https://api.github.com；只有测试或 GitHub Enterprise
# 兼容 API 才需要改。生产反代把 /api/* 转发到 Bun API（9001），PocketBase
# 挂在 /db 下；前端路由 /feedback 不占用。
# GITHUB_API_URL=https://api.github.com
# Release 资产上传地址，默认 https://uploads.github.com；只有测试 mock 才需要改。
# GITHUB_UPLOADS_URL=https://uploads.github.com
# Issue 的 open/closed 状态会写回 feedback_reports。写共享的功能建议需要管理员
# 权限，Bun API 会复用 .env.app 里已有的 SUPERUSER_EMAIL / SUPERUSER_PASSWORD；
# 开发环境默认使用 dev_seed 创建的 dev@mimi.local / mimi123456（失败时退回用
# 调用者自己的令牌，只写自己的报告）。
# SUPERUSER_EMAIL=you@example.com
# SUPERUSER_PASSWORD=...

# 动态视频压缩（可选）。服务器装好 ffmpeg 后，大视频会先压成 1280px 以内的
# H.264/AAC MP4 再存进 PocketBase；没装时客户端自动按原视频上传，发帖不受影响。
# 可以用 FFMPEG_PATH 指定二进制路径，默认直接调用 PATH 里的 ffmpeg。
# FFMPEG_PATH=/usr/bin/ffmpeg

# 部署到 Vercel 时，必须在 Vercel 项目的环境变量里把
# VITE_POCKETBASE_URL 设为绝对地址（不能填 same-origin / 127.0.0.1），例如：
# VITE_POCKETBASE_URL=https://pb.example.com
# 它们是合法值，但会让页面连到自己的域名或 localhost，找不到 PocketBase；
# 只有缺失或格式错误时 lib/env.ts 才会在加载时抛错。Vercel 是独立的前端
# 域名，和自托管 PocketBase 页面是两个 origin，各自的 SW 缓存与
# localStorage 互不相通（mimi:ai:v1、mimi-theme、AI 缓存需要分别设置一次）。
# 详见 README 第十一节。
