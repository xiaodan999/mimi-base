# Runtime environment for mimi-app (compose `env_file`). This is NOT the
# image build environment: the SPA is built with VITE_POCKETBASE_URL=same-origin
# and no secrets are baked into the image.
#
# Copy to the deployment root as `.env.app`, chmod 600, and never commit it.

PB_URL=http://mimi-pb:8090
PORT=9001

# AI (site key; the browser never sees it). Empty = AI features answer 503.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
AI_DAILY_REQUESTS_PER_USER=100
# OPENCODE_CHAT_MODELS=deepseek-v4.1-flash,glm-5.3-flash,mimo-v2.6-flash
# OPENCODE_CHAT_MODEL_DEFAULT=deepseek-v4.1-flash

# Feedback -> GitHub issue. Missing token/repo keeps the report in 待同步.
GITHUB_TOKEN=
GITHUB_REPO=
# GITHUB_API_URL=https://api.github.com
# GITHUB_UPLOADS_URL=https://uploads.github.com

# Needed for feature-suggestion state write-back; also the dashboard login.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Optional; ffmpeg is installed in the app image.
# FFMPEG_PATH=/usr/bin/ffmpeg
