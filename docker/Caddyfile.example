# Replace dan-pb.zxvcn.com with the real host and keep this block inside the
# site that already exists in /root/main/Caddyfile. `caddy-net` is the network
# the main Caddy container is attached to (172.19.0.0/16 on the VPS).
#
#   docker exec main-caddy-1 caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec main-caddy-1 caddy reload  --config /etc/caddy/Caddyfile --adapter caddyfile

dan-pb.zxvcn.com {
    handle /db/_ { redir /db/_/ 308 }
    handle /db   { redir /db/ 308 }

    # PocketBase API, admin dashboard and realtime SSE. Strip /db.
    handle_path /db/* {
        reverse_proxy mimi-pb:8090 {
            flush_interval -1
        }
    }

    # AI relay, feedback, video compression.
    handle /api/* {
        reverse_proxy mimi-app:9001 {
            flush_interval -1
        }
    }

    # The API sets these too; keeping them here also covers 404s and redirects.
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @revalidate path / /index.html /sw.js /manifest.json /version.json
    header @revalidate Cache-Control "no-cache"

    encode zstd gzip

    # SPA shell, hashed assets, PWA files.
    handle {
        reverse_proxy mimi-app:9001 {
            flush_interval -1
        }
    }
}
